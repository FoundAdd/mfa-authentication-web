{
  "name": "hybrid-totp",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview",
    "cap:sync": "npm run build && npx cap sync android",
    "android:debug": "npm run cap:sync && node scripts/android-gradle.mjs assembleDebug",
    "android:release": "npm run cap:sync && node scripts/android-gradle.mjs assembleRelease"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "^7.5.0",
    "@capacitor/android": "^7.6.8",
    "@capacitor/app": "^7.1.2",
    "@capacitor/cli": "^7.6.8",
    "@capacitor/core": "^7.6.8",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/share": "^7.0.4",
    "@element-plus/icons-vue": "^2.3.2",
    "@vueuse/core": "^13.1.0",
    "element-plus": "^2.9.8",
    "html5-qrcode": "^2.3.8",
    "localforage": "^1.10.0",
    "otpauth": "^9.4.0",
    "pinia": "^3.0.2",
    "vite-plugin-pwa": "^1.0.0",
    "vue": "^3.5.13",
    "vue-i18n": "^11.1.2",
    "vue-router": "^4.6.4",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "eslint": "^9.24.0",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.0.0",
    "happy-dom": "^17.6.3",
    "prettier": "^3.5.3",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.2",
    "vitest": "^3.1.1",
    "vue-tsc": "^2.2.8"
  }
}
